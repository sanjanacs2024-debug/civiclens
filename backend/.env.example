MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
# Optional: override Node's DNS resolvers (comma-separated). Useful when the
# system resolver (e.g. a dead localhost stub) cannot resolve mongodb+srv SRV
# records. Leave unset to use the system default resolvers.
# DNS_SERVERS=10.10.20.55

# Escalation Center demo mode. Set to true ONLY to switch on the 30 second
# simulated clock used for hackathon presentations and testing.
#
# The real escalation rule is a fixed 14 days and is NOT configurable here. Demo
# mode cannot change it: the simulation reads the same stored 14 day deadline and
# only returns a projected state, it never writes an escalation to the database.
# Leave this false for normal, real-world operation.
ESCALATION_DEMO_MODE=false